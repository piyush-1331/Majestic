# Majestic Interior & Furniture — Environment Variables Template
# Copy this file to .env locally. For Render deployment, add these in your Render Dashboard (Environment tab).
# Note: Never commit your actual .env file with real secrets.

# Flask Application Secret Key
SECRET_KEY=majestic_interior_furniture_pbl_secret_key

# Email/SMTP Configuration (Task 4)
# Default provider: Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True

# Enter your Gmail address (supports both MAIL_USERNAME and SMTP_USERNAME)
MAIL_USERNAME=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com

# Enter your 16-character Gmail App Password (NOT your normal Google account password)
# To generate one:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an App name (e.g., "Majestic PBL") and copy the 16-character password here
MAIL_PASSWORD=your_16_char_app_password
SMTP_PASSWORD=your_16_char_app_password

# Sender display name and email address
MAIL_SENDER="Majestic Interior & Furniture <your_email@gmail.com>"
SMTP_SENDER="Majestic Interior & Furniture <your_email@gmail.com>"

# Razorpay Payment Gateway Configuration (Task 5 - TEST MODE ONLY)
# Get your Test API Keys from Razorpay Dashboard: Settings -> API Keys (Test Mode)
# Important: Never use Live keys. Key Secret must remain strictly server-side.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key



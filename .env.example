# Majestic Interior & Furniture — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# Note: Never commit your actual .env file with real secrets.

# Flask Application Secret Key
SECRET_KEY=majestic_interior_furniture_pbl_secret_key

# SMTP Email Configuration (Task 4)
# Default provider: Gmail SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# Enter your Gmail address (e.g., student@gmail.com)
SMTP_USERNAME=your_email@gmail.com

# Enter your 16-character Gmail App Password (NOT your normal Google account password)
# To generate one:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an App name (e.g., "Majestic PBL") and copy the 16-character password here
SMTP_PASSWORD=your_16_char_app_password

# Sender display name and email address
SMTP_SENDER="Majestic Interior & Furniture <your_email@gmail.com>"

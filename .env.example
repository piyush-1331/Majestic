# Majestic Interior & Furniture — Environment Variables Template
# Copy this file to .env locally. For Render deployment, add these in your Render Dashboard (Environment tab).
# Note: Never commit your actual .env file with real secrets.

# Flask Application Secret Key
SECRET_KEY=majestic_interior_furniture_pbl_secret_key

# ==============================================================================
# Email Notification Configuration (Task 4)
# ==============================================================================
# The system supports two email providers:
#
# Option A: Gmail SMTP (RECOMMENDED — Sends directly to ANY entered email address!)
#   - Free, no custom domain required.
#   - 1. Go to: https://myaccount.google.com/apppasswords (ensure 2-Step Verification is ON)
#   - 2. Create an App Name (e.g. "Majestic Web") and copy the 16-character password.
#   - 3. Set SMTP_USERNAME and SMTP_PASSWORD below.
#
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_SENDER="Majestic Interior & Furniture <your_gmail_address@gmail.com>"

# Option B: Resend Email API over HTTPS (REST API)
#   - Note: Resend's free trial sender ('onboarding@resend.dev') ONLY delivers to your
#     Resend account owner email.
#   - To send to ANY entered recipient using Resend, verify your custom domain at:
#     https://resend.com/domains and set RESEND_FROM_EMAIL to an address on your domain.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev

# ==============================================================================
# Razorpay Payment Gateway Configuration (Task 5 - TEST MODE ONLY)
# ==============================================================================
# Get your Test API Keys from Razorpay Dashboard: Settings -> API Keys (Test Mode)
# Important: Never use Live keys. Key Secret must remain strictly server-side.
RAZORPAY_KEY_ID=rzp_test_your_test_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key
